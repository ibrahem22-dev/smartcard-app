  "weights": {
    "regular": 400,
    "medium": 500,
    "semibold": 600,
    "bold": 700,
    "notShipped": [{ "weight": 300, "reason": "Light exists upstream for Hebrew/Arabic only; no approved functional role in V1" }],
    "syntheticWeights": "PROHIBITED — font-synthesis: none"
  },
  "numericBehavior": {
    "digits": "TABULAR BY DEFAULT IN ALL THREE SCRIPT FAMILIES",
    "tnumRequired": false,
    "evidence": "hmtx advance spread 0.00 units/em (upm 1000) verified per binary in PHASE_9_FONT_INVENTORY_RAW.json; no tnum GSUB feature exists in any build",
    "minusSignData": "U+2212 preferred in data contexts (present in all builds)",
    "currencySymbolsNative": ["₪", "$", "€", "£"]
  },
  "scriptCalibration": {
    "latin": { "lineHeightPolicy": "base", "letterSpacingPolicy": "per-token" },
    "hebrew": {
      "lineHeightPolicy": "same-as-latin (Plex Hebrew rhythm measured tight/professional)",
      "letterSpacingPolicy": "always 0 — no uppercase concept, no mechanical tracking",
      "uppercaseRule": "NEVER uppercase Hebrew labels"
    },
    "arabic": {
      "lineHeightPolicy": "+4..6px vs Latin per token — prevents mark/extender clipping",
      "letterSpacingPolicy": "ALWAYS 0 — joined script; tracking visually breaks connections",
      "uppercaseRule": "NEVER uppercase Arabic labels"
    }
  },
