  "brandBehavior": {
    "trevik": {
      "voice": "clear, practical, consumer-facing, precise, approachable",
      "rules": [
        "Full hierarchy contrast permitted: 600 card titles/H2/H3 prominent",
        "Prominent numeric values: Data XL/L 600",
        "Buttons/labels 500",
        "Warmth carried by G1 wordmark, TM-C mark, layout, spacing — not by altering type"
      ]
    },
    "sorlane": {
      "voice": "calm, mature, global, understated, stable",
      "rules": [
        "Restrained headlines: Display/H1 600 max, prefer generous whitespace over weight",
        "Sub-headings may use 500",
        "Avoid 700 in corporate contexts except exceptional statements",
        "Never let UI typography imitate SW-B artwork"
