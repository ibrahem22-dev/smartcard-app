      "license": "SIL OFL 1.1"
    },
    "hebrew": {
      "family": "IBM Plex Sans Hebrew",
      "version": "1.2",
      "upstream": "google/fonts ofl/ibmplexsanshebrew",
      "license": "SIL OFL 1.1"
